{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sanstechno.in" }],
      "destination": "/in/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sanstechno.in" }],
      "destination": "/in/:path*"
    },
    {
      "source": "/",
      "destination": "/de/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/de/:path*"
    }
  ]
}